<Window
    x:Class="StartFlow.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewmodels="using:StartFlow.ViewModels"
    xmlns:local="using:StartFlow.UI"
    Title="StartFlow - Delayed Startup Manager">

    <!-- 开启 Win11 云母毛玻璃背景特效 -->
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Padding="24" Background="Transparent">
        <Grid.Resources>
            <ResourceDictionary>
            <!-- 自定义主题颜色字典，实现亮/暗色模式下的精准灰度控制 -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppIconBackgroundBrush" Color="#E5E5E5" />
                    <SolidColorBrush x:Key="AppIconForegroundBrush" Color="#707070" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppIconBackgroundBrush" Color="#666666" />
                    <SolidColorBrush x:Key="AppIconForegroundBrush" Color="#E0E0E0" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppIconBackgroundBrush" Color="#666666" />
                    <SolidColorBrush x:Key="AppIconForegroundBrush" Color="#E0E0E0" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- 定义差异化显示选单模板 -->
            <local:ShortTierNameConverter x:Key="ShortTierNameConverter" />
            <local:TierCustomNameConverter x:Key="TierCustomNameConverter" />
            <local:TierTemplateSelector x:Key="TierTemplateSelector">
                <local:TierTemplateSelector.SelectedTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Converter={StaticResource ShortTierNameConverter}}" VerticalAlignment="Center" />
                    </DataTemplate>
                </local:TierTemplateSelector.SelectedTemplate>
                <local:TierTemplateSelector.DropdownTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                    </DataTemplate>
                </local:TierTemplateSelector.DropdownTemplate>
            </local:TierTemplateSelector>

            <DataTemplate x:Key="ManageTierItemTemplate" x:DataType="viewmodels:EditableTier">
                <Grid Margin="0,4" Background="Transparent" DoubleTapped="ManageTierItem_DoubleTapped">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <FontIcon Grid.Column="0" Glyph="&#xE700;" FontSize="12" Foreground="Gray" Margin="0,0,12,0" VerticalAlignment="Center" ToolTipService.ToolTip="Drag to reorder" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" Visibility="{x:Bind IsNotEditingVisibility, Mode=OneWay}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource TierCustomNameConverter}}" Visibility="{x:Bind IsEditingVisibility, Mode=OneWay}" VerticalAlignment="Center" LostFocus="ManageTierItem_TextBoxLostFocus" KeyDown="ManageTierItem_TextBoxKeyDown" />
                    <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Click="RemoveManageTier_Click" ToolTipService.ToolTip="Remove Tier">
                        <FontIcon Glyph="&#xE74D;" FontSize="12" />
                    </Button>
                </Grid>
            </DataTemplate>
            </ResourceDictionary>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="System Startup Apps" FontSize="24"
                       FontWeight="Bold" VerticalAlignment="Center" />
                       
            <CommandBar HorizontalAlignment="Right" Background="Transparent"
                        DefaultLabelPosition="Collapsed">
                <!-- 次要操作：添加/删除 -->
                <AppBarButton Icon="Add" Click="AddButton_Click" 
                              Label="Add App" ToolTipService.ToolTip="Add App" />
                <AppBarButton Icon="List" Click="ManageTiers_Click" 
                              Label="Manage Tiers" ToolTipService.ToolTip="Manage Tiers" />
                <AppBarSeparator />
                <!-- 核心操作：保存、刷新、主题、设置 -->
                <AppBarButton Icon="Save" Click="SaveButton_Click" 
                              Label="Save Configuration" ToolTipService.ToolTip="Save Configuration" />
                <AppBarButton Icon="Refresh" Click="RefreshButton_Click" 
                              Label="Refresh List" ToolTipService.ToolTip="Refresh List" />
                <AppBarButton x:Name="ThemeButton" Click="ThemeButton_Click" 
                              Label="Toggle Theme" ToolTipService.ToolTip="Toggle Theme" />
            </CommandBar>
        </Grid>

        <ListView Grid.Row="1" 
                  ItemsSource="{x:Bind ViewModel.TierGroups, Mode=OneWay}"
                  SelectionMode="None">
            
            <!-- 使用内嵌 List 替代官方 Group 从而解锁原生拖放物理动画 -->
            <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:TierGroup">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,15,0,10">
                                    <!-- 加入位移过渡动画：当内部元素增加导致宽度变化时，平滑挤开其他元素 -->
                                    <StackPanel.Transitions>
                                        <TransitionCollection>
                                            <RepositionThemeTransition />
                                        </TransitionCollection>
                                    </StackPanel.Transitions>
                                <TextBlock Text="{x:Bind TierName}" FontSize="18" 
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                <Button Click="ToggleGroup_Click" 
                                        Visibility="{x:Bind ToggleVisibility, Mode=OneWay}"
                                        Background="Transparent" BorderThickness="0"
                                        Padding="4" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Toggle Expand">
                                    <FontIcon Glyph="{x:Bind ExpandIconGlyph, Mode=OneWay}" FontSize="14" />
                                </Button>

                                <!-- 新增：右向箭头切换按钮 -->
                                <Button Click="ToggleTierActions_Click" 
                                        Visibility="{x:Bind local:MainWindow.GetSilentButtonVisibility(TierName), Mode=OneWay}"
                                        Background="Transparent" BorderThickness="0" Padding="4" VerticalAlignment="Center"
                                        ToolTipService.ToolTip="Toggle Tier Actions">
                                    <FontIcon Glyph="{x:Bind ActionsToggleIconGlyph, Mode=OneWay}" FontSize="12" />
                                </Button>

                                <!-- 被折叠的面板：时钟设置与一键静默 -->
                                <StackPanel Orientation="Horizontal" Visibility="{x:Bind ActionsVisibility, Mode=OneWay}" Spacing="6">
                                    <!-- 加入进出场过渡动画：点击箭头时，面板会伴随渐变和滑动丝滑出现 -->
                                    <StackPanel.Transitions>
                                        <TransitionCollection>
                                            <AddDeleteThemeTransition />
                                        </TransitionCollection>
                                    </StackPanel.Transitions>
                                    <Button Click="TierSettings_Click" 
                                            Height="28" Width="36" Padding="0"
                                            Background="Transparent" BorderThickness="0"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Tier Execution Settings (Delay &amp; Mode)">
                                        <FontIcon Glyph="&#xE121;" FontSize="16" />
                                    </Button>
                                    <Button Click="SetTierSilent_Click" 
                                            Height="28" Width="36" Padding="0"
                                            Background="Transparent" BorderThickness="0"
                                            VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Toggle Silent for all apps in this tier">
                                        <FontIcon Glyph="{x:Bind local:MainWindow.GetSilentIcon(IsAllSilent), Mode=OneWay}" FontSize="16" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                                <!-- 内嵌 ListView，专门负责完美的原生拖拽物理动画 -->
                                <ListView ItemsSource="{x:Bind}"
                                          SelectionMode="None"
                                          CanReorderItems="True"
                                          AllowDrop="True">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodels:AppItemViewModel">
                    <!-- 具有呼吸感和阴影边框的卡片设计 -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="12,8"
                            Margin="0,2,0,2" 
                            HorizontalAlignment="Stretch"
                            Visibility="{x:Bind ItemVisibility, Mode=OneWay}">
                        <!-- 为 App 卡片加上过渡动画：当一整个 Tier 被折叠/展开时，卡片会丝滑地依次飞入/淡出 -->
                        <Border.Transitions>
                            <TransitionCollection>
                                <AddDeleteThemeTransition />
                                <RepositionThemeTransition />
                            </TransitionCollection>
                        </Border.Transitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Column="0" VerticalAlignment="Center">
                                <!-- 拖拽手柄：三条横线图标 -->
                                <FontIcon Glyph="&#xE700;" FontSize="12" Foreground="Gray" 
                                          Margin="0,0,14,0" VerticalAlignment="Center"
                                          ToolTipService.ToolTip="Drag to reorder" />
                                
                                <!-- 占位图标：后续可以通过 P/Invoke 提取真实 EXE 图标 -->
                                <Border Width="32" Height="32" CornerRadius="4" 
                                        Background="{ThemeResource AppIconBackgroundBrush}"
                                        Margin="0,0,12,0">
                                    <Grid>
                                        <TextBlock Text="{x:Bind FallbackText}" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{ThemeResource AppIconForegroundBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{x:Bind FallbackVisibility, Mode=OneWay}" />
                                        <Image Source="{x:Bind AppIcon, Mode=OneWay}" 
                                               Width="24" Height="24" Stretch="Uniform" 
                                               Visibility="{x:Bind RealIconVisibility, Mode=OneWay}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- 文本信息 -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind Item.Name}" FontSize="16"
                                           FontWeight="SemiBold" 
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Item.FilePath}" FontSize="12" 
                                           Foreground="Gray" 
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- 右侧交互区：高级参数与T级别选择器 -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" 
                                        VerticalAlignment="Center" Spacing="10">

                                <!-- 静默启动开关 -->
                                <Button Click="ToggleAppSilent_Click"
                                        Background="Transparent" BorderThickness="0"
                                        Height="32" Width="40" Padding="0"
                                        ToolTipService.ToolTip="Toggle Silent (Run hidden/minimized)">
                                    <FontIcon Glyph="{x:Bind local:MainWindow.GetSilentIcon(IsSilent), Mode=OneWay}" FontSize="16" />
                                </Button>

                                <TextBlock Text="Tier:" VerticalAlignment="Center" 
                                           Foreground="Gray" />
                                <ComboBox SelectedIndex="{x:Bind PriorityIndex, Mode=TwoWay}" 
                                          ItemsSource="{x:Bind AvailableTiers}"
                                          ItemTemplateSelector="{StaticResource TierTemplateSelector}"
                                          Width="75" MinWidth="75">
                                </ComboBox>
                                
                                <!-- 定位按钮 -->
                                <Button Click="OpenLocation_Click" 
                                        ToolTipService.ToolTip="Open Location"
                                        Background="Transparent" BorderThickness="0">
                                    <FontIcon Glyph="&#xE8DA;" FontSize="16" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="Margin" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                            </StackPanel>
                        </DataTemplate>
            </ListView.ItemTemplate>
            
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <!-- 消除自带的悬停高亮底色，让内部的圆角卡片视觉更独立 -->
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="MinHeight" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <!-- 全局加载过渡动画 (Windows 标准转圈进度条) -->
        <ProgressRing Grid.Row="1"
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Width="64" Height="64"
                      HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</Window>